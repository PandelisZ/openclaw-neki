diff --git a/src/infra/database-engine/schema-lifecycle.ts b/src/infra/database-engine/schema-lifecycle.ts
new file mode 100644
--- /dev/null
+++ b/src/infra/database-engine/schema-lifecycle.ts
@@ -0,0 +1,132 @@
+import fs from "node:fs";
+import { createRequire } from "node:module";
+import path from "node:path";
+import type { DatabaseSync } from "node:sqlite";
+import { sameFileIdentity } from "@openclaw/fs-safe/advanced";
+import { openPluginRootFileSync } from "../../plugins/path-safety.js";
+import type { PluginOrigin } from "../../plugins/plugin-origin.types.js";
+import type { PostgresSqlConnection } from "../sql-connection.js";
+import { assertEngineStoreExecutionAllowed } from "./admission-scope.js";
+
+/** Serializable manifest-owned source captured before database workers start. */
+export type PostgresSchemaLifecycleDescriptor = Readonly<{
+  pluginId: string;
+  modulePath: string;
+  boundaryRoot: string;
+  origin: PluginOrigin;
+  rejectHardlinks: boolean;
+}>;
+
+/** Experimental v1: fresh agent bootstrap only; runtime transactions remain core-owned. */
+export interface PostgresSchemaLifecycleV1 {
+  version: 1;
+  derivedSearch: "unavailable";
+  sequenceAllocation: "standalone";
+  initializeConnection(input: { db: PostgresSqlConnection; assertCurrent: () => void }): void;
+  activateRuntime(input: {
+    db: PostgresSqlConnection;
+    namespace: string;
+    store: string;
+    storeId: string;
+    version: number;
+    assertCurrent: () => void;
+  }): void;
+  beforeSeal(input: PostgresSchemaPreparation): void;
+  afterSeal(input: PostgresSchemaPreparation): void;
+  prepare(input: PostgresSchemaPreparation): { fresh: boolean };
+  executeFreshDdl(input: {
+    db: PostgresSqlConnection;
+    ddl: string;
+    assertCurrent: () => void;
+  }): void;
+}
+
+export type PostgresSchemaPreparation = {
+  db: PostgresSqlConnection;
+  namespace: string;
+  storeId: string;
+  store: string;
+  version: number;
+  ddl: string;
+  metadataSql: string;
+  journalPath: string;
+  allowCreate: boolean;
+  assertCurrent: () => void;
+};
+
+const require = createRequire(import.meta.url);
+const providers = new WeakMap<PostgresSqlConnection, PostgresSchemaLifecycleV1>();
+
+export function bindPostgresSchemaLifecycle(
+  db: PostgresSqlConnection,
+  descriptor?: PostgresSchemaLifecycleDescriptor,
+  assertCurrent: () => void = assertEngineStoreExecutionAllowed,
+): void {
+  if (!descriptor) {
+    return;
+  }
+  if (![".mjs", ".cjs", ".js"].includes(path.extname(descriptor.modulePath))) {
+    throw new Error("Pre-boot schema lifecycle artifacts must be built JavaScript");
+  }
+  const opened = openPluginRootFileSync({
+    filePath: descriptor.modulePath,
+    rootPath: descriptor.boundaryRoot,
+    rejectHardlinks: descriptor.rejectHardlinks,
+  });
+  if (!opened.ok) {
+    throw new Error("Cannot open PostgreSQL schema lifecycle artifact", { cause: opened.error });
+  }
+  fs.closeSync(opened.fd);
+  if (!sameFileIdentity(opened.exactIdentity, fs.statSync(opened.path, { bigint: true }))) {
+    throw new Error("PostgreSQL schema lifecycle artifact changed after validation");
+  }
+  const module: unknown = require(opened.path);
+  if (typeof module !== "object" || module === null) {
+    throw new Error("Invalid PostgreSQL schema lifecycle module");
+  }
+  const provider = "default" in module ? module.default : undefined;
+  if (
+    typeof provider !== "object" ||
+    provider === null ||
+    !("version" in provider) ||
+    provider.version !== 1 ||
+    !("derivedSearch" in provider) ||
+    provider.derivedSearch !== "unavailable" ||
+    !("sequenceAllocation" in provider) ||
+    provider.sequenceAllocation !== "standalone" ||
+    !("initializeConnection" in provider) ||
+    typeof provider.initializeConnection !== "function" ||
+    !("activateRuntime" in provider) ||
+    typeof provider.activateRuntime !== "function" ||
+    !("prepare" in provider) ||
+    typeof provider.prepare !== "function" ||
+    !("beforeSeal" in provider) ||
+    typeof provider.beforeSeal !== "function" ||
+    !("afterSeal" in provider) ||
+    typeof provider.afterSeal !== "function" ||
+    !("executeFreshDdl" in provider) ||
+    typeof provider.executeFreshDdl !== "function"
+  ) {
+    throw new Error(
+      `Plugin ${descriptor.pluginId} has no valid PostgreSQL schema lifecycle v1 export`,
+    );
+  }
+  const lifecycle = provider as PostgresSchemaLifecycleV1;
+  lifecycle.initializeConnection({ db, assertCurrent });
+  providers.set(db, lifecycle);
+}
+
+export function getPostgresSchemaLifecycle(db: PostgresSqlConnection) {
+  return providers.get(db);
+}
+
+export function schemaPreparationJournalPath(anchor: DatabaseSync): string {
+  const file = anchor
+    .prepare("PRAGMA database_list")
+    .all()
+    .find((row) => row.name === "main")?.file;
+  if (typeof file !== "string" || !file) {
+    throw new Error("Schema lifecycle preparation requires a persistent SQLite identity anchor");
+  }
+  return `${file}.schema-preparation.sqlite`;
+}
diff --git a/src/infra/database-engine/schema-lifecycle-config.ts b/src/infra/database-engine/schema-lifecycle-config.ts
new file mode 100644
--- /dev/null
+++ b/src/infra/database-engine/schema-lifecycle-config.ts
@@ -0,0 +1,42 @@
+import path from "node:path";
+import type { OpenClawConfig } from "../../config/types.js";
+import { normalizePluginsConfigWithResolver } from "../../plugins/config-policy.js";
+import { shouldRejectHardlinkedPluginFiles } from "../../plugins/hardlink-policy.js";
+import { loadPluginManifestRegistryCore } from "../../plugins/manifest-registry.js";
+import type { PostgresSchemaLifecycleDescriptor } from "./schema-lifecycle.js";
+
+export function resolvePostgresSchemaLifecycle(
+  config: OpenClawConfig,
+  pluginId: string,
+  env: NodeJS.ProcessEnv,
+): PostgresSchemaLifecycleDescriptor {
+  const policy = normalizePluginsConfigWithResolver(config.plugins);
+  if (
+    !policy.enabled ||
+    policy.entries[pluginId]?.enabled !== true ||
+    policy.deny.includes(pluginId) ||
+    (policy.allow.length > 0 && !policy.allow.includes(pluginId))
+  ) {
+    throw new Error(
+      `PostgreSQL schema lifecycle plugin ${pluginId} must be explicitly enabled and allowed`,
+    );
+  }
+  // Before database boot, discover configured plugin roots without consulting its installed-state DB.
+  const registry = loadPluginManifestRegistryCore({ config, env, installRecords: {} });
+  const matches = registry.plugins.filter((plugin) => plugin.id === pluginId);
+  const plugin = matches.length === 1 ? matches[0] : undefined;
+  if (!plugin?.postgresSchemaLifecycle) {
+    throw new Error(`Plugin ${pluginId} does not declare a PostgreSQL schema lifecycle module`);
+  }
+  return Object.freeze({
+    pluginId,
+    modulePath: path.resolve(plugin.rootDir, plugin.postgresSchemaLifecycle),
+    boundaryRoot: plugin.rootDir,
+    origin: plugin.origin,
+    rejectHardlinks: shouldRejectHardlinkedPluginFiles({
+      origin: plugin.origin,
+      rootDir: plugin.rootDir,
+      env,
+    }),
+  });
+}
