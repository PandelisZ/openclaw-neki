+/** Allocate outside the multi-write CTE while retaining the caller's transaction. */
+export function allocatePostgresSessionTranscriptFtsIds(
+  db: EngineConnection,
+  count: number,
+): string[] {
+  if (!isPostgresSqlConnection(db) || !db.isTransaction) {
+    throw new Error("PostgreSQL transcript identity allocation requires a native transaction");
+  }
+  if (!Number.isSafeInteger(count) || count < 0 || count > TRANSCRIPT_INSERT_BATCH_SIZE) {
+    throw new Error("Invalid bounded transcript identity allocation count");
+  }
+  const allocate = prepareSqliteQuerySync<undefined, { id: string }>(db, () =>
+    getNodeSqliteKysely(db).selectNoFrom(
+      /* kysely-allow-raw: Standalone sequence allocation avoids router-managed functions inside a table CTE. */
+      sql<string>`CAST(nextval(pg_get_serial_sequence('session_transcript_fts_rows', 'id')) AS text)`.as(
+        "id",
+      ),
+    ),
+  );
+  return Array.from({ length: count }, () => {
+    const id = allocate(undefined).rows[0]?.id;
+    if (typeof id !== "string" || !/^[1-9][0-9]*$/.test(id) || BigInt(id) > 9223372036854775807n) {
+      throw new Error("PostgreSQL transcript sequence returned an invalid bigint identity");
+    }
+    return id;
+  });
