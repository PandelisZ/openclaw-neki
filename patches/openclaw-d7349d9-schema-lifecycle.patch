--- /dev/null
+++ b/src/config/sessions/session-transcript-fts.neki.test.ts
@@ -0,0 +1,138 @@
+import type { SQLInputValue } from "node:sqlite";
+import { beforeEach, expect, it, vi } from "vitest";
+import type { PostgresSqlConnection } from "../../infra/sql-connection.js";
+import {
+  allocatePostgresSessionTranscriptFtsIds,
+  createSessionTranscriptFtsInserter,
+} from "./session-transcript-fts.js";
+import { createPostgresProjectionFlusher } from "./session-transcript-index-postgres.js";
+
+const state = vi.hoisted(() => ({ standalone: true }));
+vi.mock("../../infra/database-engine/schema-lifecycle.js", () => ({
+  getPostgresSchemaLifecycle: () =>
+    state.standalone ? { sequenceAllocation: "standalone" } : undefined,
+}));
+vi.mock("../../infra/database-engine/adapters.js", () => ({ admitStoreSearch: vi.fn() }));
+vi.mock("../../infra/sqlite-database-admission.js", () => ({
+  sqliteSessionIdWriteScope: (sessionId: string) => sessionId,
+  withSqliteDatabaseWriteScope: (_db: unknown, _scope: unknown, operation: () => unknown) =>
+    operation(),
+}));
+
+beforeEach(() => {
+  state.standalone = true;
+});
+
+function fixture() {
+  const queries: { sql: string; parameters: readonly SQLInputValue[] }[] = [];
+  let nextId = 9007199254740993n;
+  const db = {
+    [Symbol.for("openclaw.postgres-sync-connection")]: true,
+    isTransaction: true,
+    query(sql: string, parameters: readonly SQLInputValue[] = []) {
+      queries.push({ sql, parameters });
+      const allocation = sql.startsWith("select CAST(nextval");
+      return {
+        rows: allocation ? [{ id: String(nextId++) }] : [{ written: 1 }],
+        rowCount: 1,
+        columns: [{ name: allocation ? "id" : "written" }],
+      };
+    },
+  };
+  return { db: db as unknown as PostgresSqlConnection, queries };
+}
+
+const entries = [
+  { messageId: "first", role: "user" as const, text: "one", timestamp: 1 },
+  { messageId: "second", role: "assistant" as const, text: "two", timestamp: 2 },
+];
+
+it("allocates standalone int64 IDs losslessly only inside a native transaction", () => {
+  const { db, queries } = fixture();
+  expect(allocatePostgresSessionTranscriptFtsIds(db, 2)).toEqual([
+    "9007199254740993",
+    "9007199254740994",
+  ]);
+  expect(queries).toHaveLength(2);
+  Object.defineProperty(db, "isTransaction", { value: false });
+  expect(() => allocatePostgresSessionTranscriptFtsIds(db, 1)).toThrow(
+    /requires a native transaction/,
+  );
+  expect(queries).toHaveLength(2);
+});
+
+it("binds new standalone IDs on every cached inserter invocation", () => {
+  const { db, queries } = fixture();
+  const insert = createSessionTranscriptFtsInserter(db, "session");
+  expect(queries).toHaveLength(0);
+  insert(entries);
+  insert(entries);
+  expect(queries).toHaveLength(6);
+  for (const index of [2, 5]) {
+    const write = queries[index]!;
+    expect(write.sql).not.toContain("nextval");
+    expect(write.sql).toContain('"ids" as materialized (SELECT * FROM (VALUES');
+    expect(write.sql).toContain("AS bigint");
+    expect(write.sql).toContain('order by "position"');
+    expect(write.sql).toContain('order by "id"');
+    expect(write.parameters).toContain("first");
+    expect(write.parameters).toContain("second");
+  }
+  expect(queries[2]!.parameters).toContain("9007199254740993");
+  expect(queries[5]!.parameters).toContain("9007199254740995");
+  expect(queries[5]!.parameters).not.toContain("9007199254740993");
+});
+
+it("leaves default PostgreSQL allocation inside its existing multi-write CTE", () => {
+  state.standalone = false;
+  const { db, queries } = fixture();
+  createSessionTranscriptFtsInserter(db, "session")(entries);
+  expect(queries).toHaveLength(1);
+  expect(queries[0]!.sql).toContain("nextval(pg_get_serial_sequence(");
+  expect(queries[0]!.sql).not.toContain("standalone_ids");
+});
+
+it("projection flusher binds invocation-local standalone IDs and retains projection writes", () => {
+  const { db, queries } = fixture();
+  const flush = createPostgresProjectionFlusher(db, "session");
+  expect(queries).toHaveLength(0);
+  const chunk = {
+    activeRows: [],
+    ftsRows: entries,
+    watermark: {
+      activeEventCount: 2,
+      activeMessageCount: 2,
+      indexedSeq: 2,
+      leafEventId: "second",
+      needsRebuild: false,
+      updatedAt: 3,
+    },
+  };
+  flush(chunk, false);
+  flush(chunk, true);
+  expect(queries).toHaveLength(6);
+  expect(queries[2]!.sql).toContain('insert into "session_transcript_index_state"');
+  expect(queries[2]!.sql).toContain('"ids" as materialized (SELECT * FROM (VALUES');
+  expect(queries[5]!.sql).toContain('update "session_transcript_index_state"');
+  for (const index of [2, 5]) {
+    expect(queries[index]!.sql).not.toContain("nextval");
+  }
+  expect(queries[2]!.parameters).toContain("9007199254740993");
+  expect(queries[5]!.parameters).toContain("9007199254740995");
+});
+
+it("never executes the multi-write CTE after an allocation failure", () => {
+  const { db, queries } = fixture();
+  const query = db.query;
+  db.query = (sql, parameters) => {
+    if (queries.length === 1) {
+      throw new Error("allocation custody expired");
+    }
+    return query(sql, parameters);
+  };
+  expect(() => createSessionTranscriptFtsInserter(db, "session")(entries)).toThrow(
+    /allocation custody expired/,
+  );
+  expect(queries).toHaveLength(1);
+  expect(queries[0]!.sql).toContain("nextval");
+});
