@@ -0,0 +1,85 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, expect, it } from "vitest";
+import { resolveDatabaseEngineSelection } from "./config.js";
+const roots: string[] = [];
+afterEach(() => {
+  for (const root of roots.splice(0)) {
+    fs.rmSync(root, { recursive: true, force: true });
+  }
+});
+const connection = "postgres://synthetic@localhost/test";
+function fixture() {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "openclaw-lifecycle-"));
+  roots.push(root);
+  fs.writeFileSync(
+    path.join(root, "package.json"),
+    JSON.stringify({
+      name: "synthetic-neki",
+      version: "1.0.0",
+      type: "module",
+      openclaw: { extensions: ["./index.mjs"] },
+    }),
+  );
+  fs.writeFileSync(
+    path.join(root, "index.mjs"),
+    'throw new Error("runtime must not execute during config resolution")',
+  );
+  fs.writeFileSync(
+    path.join(root, "profile.mjs"),
+    'throw new Error("provider must not execute on host")',
+  );
+  fs.writeFileSync(
+    path.join(root, "openclaw.plugin.json"),
+    JSON.stringify({
+      id: "synthetic-neki",
+      categories: ["infrastructure"],
+      configSchema: { type: "object", properties: {} },
+      postgresSchemaLifecycle: "./profile.mjs",
+    }),
+  );
+  return {
+    root,
+    config: {
+      database: {
+        engine: "sqlite" as const,
+        families: { agent: { engine: "postgres" as const } },
+        postgres: { connection, schemaLifecycleProvider: "synthetic-neki" },
+      },
+      plugins: {
+        enabled: true,
+        allow: ["synthetic-neki"],
+        load: { paths: [root] },
+        entries: { "synthetic-neki": { enabled: true } },
+      },
+    },
+  };
+}
+it("captures only manifest metadata before boot and serializes descriptor to workers", async () => {
+  const { root, config } = fixture();
+  const selected = await resolveDatabaseEngineSelection(config);
+  expect(selected.postgres?.schemaLifecycle).toMatchObject({
+    pluginId: "synthetic-neki",
+    modulePath: path.join(root, "profile.mjs"),
+    boundaryRoot: root,
+  });
+  expect(structuredClone(selected).postgres?.schemaLifecycle).toEqual(
+    selected.postgres?.schemaLifecycle,
+  );
+});
+it("refuses disabled providers and non-agent PostgreSQL families before boot", async () => {
+  const { config } = fixture();
+  config.plugins.entries["synthetic-neki"].enabled = false;
+  await expect(resolveDatabaseEngineSelection(config)).rejects.toThrow(/explicitly enabled/);
+  config.plugins.entries["synthetic-neki"].enabled = true;
+  await expect(
+    resolveDatabaseEngineSelection({
+      ...config,
+      database: {
+        ...config.database,
+        families: { state: { engine: "postgres" }, agent: { engine: "postgres" } },
+      },
+    }),
+  ).rejects.toThrow(/only the agent family/);
+});
